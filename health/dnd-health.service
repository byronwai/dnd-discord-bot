[Unit]
Description=D&D Party Health Board Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=/home/<USER>/dnd-health-bot
EnvironmentFile=/home/<USER>/dnd-health-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/<USER>/dnd-dm-bot/venv/bin/python health_board.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

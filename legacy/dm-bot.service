[Unit]
Description=D&D DM Bot (Discord + Telegram)
After=network.target dm-llm.service
Wants=dm-llm.service

[Service]
Type=simple
User=byronwai
WorkingDirectory=/home/byronwai/dnd-dm-bot
EnvironmentFile=/home/byronwai/dnd-dm-bot/.env
ExecStart=/home/byronwai/dnd-dm-bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

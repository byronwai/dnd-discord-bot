[Unit]
Description=llama.cpp embedding server (SRD rules retrieval)
After=network.target

[Service]
Type=simple
User=byronwai
WorkingDirectory=/home/byronwai
ExecStart=/home/byronwai/llama.cpp/build/bin/llama-server \
  -m /home/byronwai/models/bge-small-en-v1.5-q8_0.gguf \
  --embedding --pooling cls -c 8192 -t 2 \
  --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target

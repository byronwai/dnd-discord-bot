# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# LLM (Ollama)
LLM_URL=http://127.0.0.1:11434
V4_DIGEST_MODEL=gemma3:12b-it-qat
# narrator: qwen3.5:35b is ~13x faster than gemma3:27b on GB10 with
# better zh prose — but it's a REASONING model: V4_NARR_THINK=off is
# required (thinking would consume the whole token budget)
V4_NARR_MODEL=qwen3.5:35b
V4_NARR_THINK=off

# Which channel the v4 engine owns (all plain text there = table talk)
V4_CHANNEL_ID=

# Optional tuning
DM_NARR_TOKENS=500
MAX_HISTORY=60
DM_RAW_WINDOW=12

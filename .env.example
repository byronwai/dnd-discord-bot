# Copy to .env and fill in the token.
# Discord: https://discord.com/developers/applications (Bot -> Token; enable MESSAGE CONTENT INTENT)
DISCORD_TOKEN=
# Ollama on GB10 (chat + embeddings)
LLM_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:27b-it-qat
EMBED_MODEL=mxbai-embed-large
EMBED_PREFIX=
MAX_TOKENS=700

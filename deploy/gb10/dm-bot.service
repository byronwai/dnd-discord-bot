[Unit]
Description=D&D DM Bot (Discord, Ollama backend)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=comfyui
WorkingDirectory=/home/comfyui/dnd-dm-bot
EnvironmentFile=/home/comfyui/dnd-dm-bot/.env
ExecStart=/home/comfyui/dnd-dm-bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

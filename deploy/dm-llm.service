[Unit]
Description=llama.cpp LLM server (D&D DM bot backend)
After=network.target

[Service]
Type=simple
User=byronwai
WorkingDirectory=/home/byronwai
ExecStart=/home/byronwai/llama.cpp/build/bin/llama-server \
  -m /home/byronwai/models/qwen2.5-3b-instruct-q4_k_m.gguf \
  --alias dnd-dm -c 16384 --parallel 1 -t 4 \
  --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
# give the model time to load before systemd considers it failed
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
